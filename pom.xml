<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger</groupId>
    <artifactId>parent-pom</artifactId>
    <version>3.1.0</version>
  </parent>
  <groupId>com.helger.phlox</groupId>
  <artifactId>phlox-parent-pom</artifactId>
  <version>0.6.1</version>
  <packaging>pom</packaging>
  <name>phlox-parent-pom</name>
  <description>phlox - EN 16931 electronic invoice visualizer - Parent POM</description>
  <url>https://github.com/phax/phlox</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <connection>scm:git:https://github.com/phax/phlox.git</connection>
    <developerConnection>scm:git:https://github.com/phax/phlox.git</developerConnection>
    <url>https://github.com/phax/phlox</url>
    <tag>phlox-parent-pom-0.6.1</tag>
  </scm>

  <developers>
    <developer>
      <id>philip</id>
      <name>Philip Helger</name>
      <email>philip(at)helger.com</email>
      <url>https://www.helger.com</url>
    </developer>
  </developers>

  <properties>
    <java.version>17</java.version>

    <ph-commons.version>12.5.3</ph-commons.version>
    <ph-ubl.version>10.2.1</ph-ubl.version>
    <ph-cii.version>4.1.3</ph-cii.version>
    <en16931-basics.version>1.0.4</en16931-basics.version>
    <ph-codelists.version>1.0.0</ph-codelists.version>
    <ph-css.version>8.4.0</ph-css.version>
    <ph-oton.version>10.7.0</ph-oton.version>
    <pdfcompare.version>1.2.11</pdfcompare.version>
    <ph-pdf-layout.version>8.4.3</ph-pdf-layout.version>
    <kaltblut.version>0.9.6</kaltblut.version>
    <picocli.version>4.7.7</picocli.version>
    <jmustache.version>1.16</jmustache.version>
    <commonmark.version>0.32.0</commonmark.version>
    <zxing.version>3.5.4</zxing.version>
    <ph-forbidden-apis.version>1.1.1</ph-forbidden-apis.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- BOM imports -->
      <dependency>
        <groupId>com.helger.commons</groupId>
        <artifactId>ph-commons-parent-pom</artifactId>
        <version>${ph-commons.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.ubl</groupId>
        <artifactId>ph-ubl-parent-pom</artifactId>
        <version>${ph-ubl.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.cii</groupId>
        <artifactId>ph-cii-parent-pom</artifactId>
        <version>${ph-cii.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger</groupId>
        <artifactId>en16931-basics</artifactId>
        <version>${en16931-basics.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.codelists</groupId>
        <artifactId>ph-codelists-unit</artifactId>
        <version>${ph-codelists.version}</version>
      </dependency>
      <!-- Before ph-oton, which imports an older version -->
      <dependency>
        <groupId>com.helger</groupId>
        <artifactId>ph-css-parent-pom</artifactId>
        <version>${ph-css.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger.photon</groupId>
        <artifactId>ph-oton-parent-pom</artifactId>
        <version>${ph-oton.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.helger</groupId>
        <artifactId>ph-pdf-layout-parent-pom</artifactId>
        <version>${ph-pdf-layout.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>de.redsix</groupId>
        <artifactId>pdfcompare</artifactId>
        <version>${pdfcompare.version}</version>
        <exclusions>
          <exclusion>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>com.helger.kaltblut</groupId>
        <artifactId>kaltblut-core</artifactId>
        <version>${kaltblut.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.kaltblut</groupId>
        <artifactId>kaltblut-verapdf</artifactId>
        <version>${kaltblut.version}</version>
      </dependency>
      <dependency>
        <groupId>info.picocli</groupId>
        <artifactId>picocli</artifactId>
        <version>${picocli.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.zxing</groupId>
        <artifactId>core</artifactId>
        <version>${zxing.version}</version>
      </dependency>
      <dependency>
        <groupId>com.samskivert</groupId>
        <artifactId>jmustache</artifactId>
        <version>${jmustache.version}</version>
      </dependency>
      <dependency>
        <groupId>org.commonmark</groupId>
        <artifactId>commonmark</artifactId>
        <version>${commonmark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.commonmark</groupId>
        <artifactId>commonmark-ext-gfm-tables</artifactId>
        <version>${commonmark.version}</version>
      </dependency>
      <dependency>
        <groupId>org.commonmark</groupId>
        <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
        <version>${commonmark.version}</version>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-testfiles</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-ubl</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-cii</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-template</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-theme</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-html</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-pdf</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-text</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.helger.phlox</groupId>
        <artifactId>phlox-cli</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Global dependencies for all modules -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.commons</groupId>
      <artifactId>ph-unittest-support-ext</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <modules>
    <module>phlox-api</module>
    <module>phlox-testfiles</module>
    <module>phlox-ubl</module>
    <module>phlox-cii</module>
    <module>phlox-template</module>
    <module>phlox-theme</module>
    <module>phlox-html</module>
    <module>phlox-pdf</module>
    <module>phlox-text</module>
    <module>phlox-cli</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>de.thetaphi</groupId>
        <artifactId>forbiddenapis</artifactId>
        <configuration>
          <signaturesArtifacts>
            <signaturesArtifact>
              <groupId>com.helger</groupId>
              <artifactId>ph-forbidden-apis</artifactId>
              <version>${ph-forbidden-apis.version}</version>
              <type>jar</type>
              <path>forbidden-apis-java9.txt</path>
            </signaturesArtifact>
          </signaturesArtifacts>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
