:root{--phlox-ink:#1d2433;--phlox-muted:#667085;--phlox-faint:#98a2b3;--phlox-rule:#e4e7ec;--phlox-wash:#f6f7f9;--phlox-accent:#245c64;--phlox-accent-wash:#e8f1f2}
*{box-sizing:border-box}
body{margin:0;color:var(--phlox-ink);font:10.5pt/1.45 -apple-system,"Segoe UI",Inter,Helvetica,Arial,sans-serif;font-variant-numeric:tabular-nums}
@media screen{body{background:#eceef2}.{p}page{margin:12mm auto;box-shadow:0 1px 3px rgba(16,24,40,.12)}}
@page{size:A4;margin:0}
@media print{.{p}page{margin:0;box-shadow:none}}
.{p}page{width:210mm;max-width:100%;min-height:297mm;background:#fff;padding:16mm 18mm}
.{p}logo{max-height:14mm;max-width:50mm}
a{color:var(--phlox-accent)}
h1,h2,h3{margin:0}
.{p}title{font-size:24pt;font-weight:650;letter-spacing:-.01em;margin:1mm 0 0}
.{p}section-title,h2.{p}section-title{font-size:8pt;letter-spacing:.12em;text-transform:uppercase;color:var(--phlox-muted);font-weight:600;margin:6mm 0 2mm;padding:0;border:0}
.{p}subsection-title,h3.{p}subsection-title{font-size:9pt;margin:3mm 0 1.5mm;font-weight:650}
p{margin:0 0 2mm}
.{p}label{font-size:7.5pt;letter-spacing:.12em;text-transform:uppercase;color:var(--phlox-muted);font-weight:600;margin:0 0 1.5mm}
.{p}kind{font-size:8.5pt;letter-spacing:.14em;text-transform:uppercase;color:var(--phlox-accent);font-weight:600;margin:0}
.{p}muted{color:var(--phlox-muted);font-size:9pt}
.{p}party-name{font-weight:650;font-size:11.5pt;margin:0 0 1mm}
.{p}row>*{min-width:0}
.{p}row:empty{display:none}
.{p}row{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:8mm}
.{p}head{grid-template-columns:1fr auto;grid-auto-flow:row}
hr{border:0;border-top:1px solid var(--phlox-rule);margin:4mm 0}
hr.{p}rule{border-top:2px solid var(--phlox-accent);margin:5mm 0 6mm}
.{p}head-logo{text-align:right}
.{p}parties{margin-bottom:5mm}
.{p}secondary{font-size:9pt;margin-bottom:5mm}
.{p}table{width:100%;border-collapse:collapse;margin:0 0 3mm}
.{p}table th{font-size:7.5pt;letter-spacing:.08em;text-transform:uppercase;color:var(--phlox-muted);font-weight:600;text-align:left;padding:2mm;border-bottom:1.5px solid var(--phlox-ink)}
.{p}table td{padding:2.4mm 2mm;border-bottom:1px solid var(--phlox-rule);vertical-align:top}
.{p}meta{width:auto;margin-top:4mm;font-size:9.5pt}
.{p}meta thead,.{p}totals thead,.{p}due thead,.{p}terms thead{display:none}
.{p}meta td{border:0;padding:.6mm 6mm .6mm 0}
.{p}totals td,.{p}due td{border:0;padding:1mm 0;font-size:9.5pt}
.{p}meta td:first-child{color:var(--phlox-muted)}
.{p}meta td:last-child{font-weight:550}
.{p}vat .{p}table th,.{p}vat .{p}table td{font-size:8.5pt;padding:1.6mm 2mm}
.{p}bottom{margin-top:6mm;grid-auto-flow:row;grid-template-columns:minmax(0,1fr) 78mm;align-items:start}
.{p}totals{background:var(--phlox-wash);border-radius:3px;padding:3mm 4mm}
.{p}totals .{p}table,.{p}due .{p}table{margin:0}
.{p}due{background:var(--phlox-accent);color:#fff;border-radius:3px;padding:3.2mm 4mm;margin-top:2mm;font-size:12pt;font-weight:650}
.{p}due td{padding:0;color:#fff;font-size:12pt}
.{p}due td:last-child{font-size:15pt}
.{p}pay{margin-top:6mm;padding:4mm;background:var(--phlox-accent-wash);border-radius:3px;font-size:9.5pt}
.{p}pay .{p}label{color:var(--phlox-accent)}
.{p}pay p{margin:0 0 2mm}
.{p}pay code{font-family:ui-monospace,Menlo,monospace}
code{font-family:ui-monospace,Menlo,monospace}
blockquote{margin:0 0 2mm;padding-left:3mm;border-left:2px solid var(--phlox-rule);color:var(--phlox-muted);font-size:9pt}
ul,ol{margin:0 0 2mm;padding-left:5mm}
li{margin:0 0 1mm}
.{p}watermark-user{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-45deg);font-size:6em;color:rgba(128,128,128,0.12);pointer-events:none;z-index:9999;user-select:none}
.{p}watermark-program{position:fixed;bottom:4mm;right:4mm;font-size:.8em;color:rgba(100,100,100,0.6);z-index:9999}
.{p}watermark-program a{color:inherit}
@media print{.{p}watermark-user{position:fixed}}
.{p}foot{margin-top:10mm;padding-top:3mm;border-top:1px solid var(--phlox-rule);font-size:7.5pt;color:var(--phlox-faint)}
.{p}lines td:first-child{width:2em;color:var(--phlox-muted)}
.{p}lines td em{font-style:normal;color:var(--phlox-muted);font-size:8.5pt}
.{p}lines th:nth-child(n+3),.{p}lines td:nth-child(n+3){text-align:right}
