<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.phlox</groupId>
    <artifactId>phlox-parent-pom</artifactId>
    <version>0.6.2-SNAPSHOT</version>
  </parent>
  <artifactId>phlox-pdf</artifactId>
  <packaging>jar</packaging>
  <name>phlox-pdf</name>
  <description>phlox - PDF output writer using ph-pdf-layout</description>
  <url>https://github.com/phax/phlox/tree/main/phlox-pdf</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-template</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-theme</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>ph-pdf-layout</artifactId>
      <exclusions>
        <!-- Only ph-pdf-layout's own tests use it: not needed at runtime -->
        <exclusion>
          <groupId>de.redsix</groupId>
          <artifactId>pdfcompare</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.helger</groupId>
      <artifactId>ph-pdf-layout-richtext</artifactId>
      <exclusions>
        <!-- Only ph-pdf-layout's own tests use it: not needed at runtime -->
        <exclusion>
          <groupId>de.redsix</groupId>
          <artifactId>pdfcompare</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-ubl</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-cii</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-testfiles</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.font</groupId>
      <artifactId>ph-fonts-roboto</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>de.redsix</groupId>
      <artifactId>pdfcompare</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PDF/A and ZUGFeRD / Factur-X checks of the output, including veraPDF -->
    <dependency>
      <groupId>com.helger.kaltblut</groupId>
      <artifactId>kaltblut-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.kaltblut</groupId>
      <artifactId>kaltblut-verapdf</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
