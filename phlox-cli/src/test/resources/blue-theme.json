{
  "$comment": "A theme in blue: the layout of the default template, with all hues from one blue scale. Every key that starts with a dollar sign is ignored.",
  "variables": {
    "--navy": "#0b1f3a",
    "--slate-blue": "#4a6285",
    "--mist": "#8aa0bf",
    "--ice": "#d3def0",
    "--frost": "#f3f7fd",
    "--blue": "#1a56db",
    "--sky": "#e6effd",

    "--phlox-ink": "var(--navy)",
    "--phlox-muted": "var(--slate-blue)",
    "--phlox-faint": "var(--mist)",
    "--phlox-rule": "var(--ice)",
    "--phlox-wash": "var(--frost)",
    "--phlox-accent": "var(--blue)",
    "--phlox-accent-wash": "var(--sky)"
  }
}
