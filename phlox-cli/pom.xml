<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.helger.phlox</groupId>
    <artifactId>phlox-parent-pom</artifactId>
    <version>0.6.0</version>
  </parent>
  <artifactId>phlox-cli</artifactId>
  <packaging>jar</packaging>
  <name>phlox-cli</name>
  <description>phlox - CLI wrapper (shaded fat JAR)</description>
  <url>https://github.com/phax/phlox/tree/main/phlox-cli</url>
  <inceptionYear>2026</inceptionYear>

  <licenses>
    <license>
      <name>Apache 2</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <dependencies>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-ubl</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-cii</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-template</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-theme</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-html</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-pdf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-text</artifactId>
    </dependency>
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
    </dependency>

    <dependency>
      <groupId>com.helger.phlox</groupId>
      <artifactId>phlox-testfiles</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.helger.font</groupId>
      <artifactId>ph-fonts-roboto</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>de.thetaphi</groupId>
        <artifactId>forbiddenapis</artifactId>
        <configuration>
          <!-- CLI module legitimately uses System.in / System.out / System.err and
               buffered I/O for stdin handling. -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <createDependencyReducedPom>false</createDependencyReducedPom>
          <shadedArtifactAttached>true</shadedArtifactAttached>
          <finalName>${project.artifactId}-full</finalName>
          <transformers>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
            <transformer implementation="org.apache.maven.plugins.shade.resource.DontIncludeResourceTransformer">
              <resources>
                <resource>.RSA</resource>
                <resource>.SF</resource>
              </resources>
            </transformer>
            <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>com.helger.phlox.cli.PhloxCli</mainClass>
            </transformer>
          </transformers>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
